{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-x64",
      "displayName": "Windows x64 (MSVC 2026)",
      "description": "Build with Visual Studio 18 2026 compiler on x64 Windows",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EFD_BUILD_TESTS": "ON",
        "EFD_BUILD_CLI": "ON"
      }
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Windows Ninja (Debug)",
      "description": "Fast build with Ninja and MSVC toolchain in Debug mode",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EFD_BUILD_TESTS": "ON",
        "EFD_BUILD_CLI": "ON"
      }
    },
    {
      "name": "windows-ninja-release",
      "displayName": "Windows Ninja (Release)",
      "description": "Optimized build with Ninja and MSVC toolchain in Release mode",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EFD_BUILD_TESTS": "ON",
        "EFD_BUILD_CLI": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-x64-debug",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-x64-release",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-ninja-debug",
      "configurePreset": "windows-ninja-debug"
    },
    {
      "name": "windows-ninja-release",
      "configurePreset": "windows-ninja-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-tests",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-ninja-tests",
      "configurePreset": "windows-ninja-debug"
    }
  ]
}
