<resources>
    <!-- 不可沿用 AppCompat 內建名稱 Theme.AppCompat.NoActionBar：深色模式下 DayNight.NoActionBar 的父主題正是它，
         同名會變成繼承自己，開深色模式的手機 (OPPO Reno13 Pro 實測) 一啟動就閃退。介面配色固定，深淺模式都用淺色主題 -->
    <style name="Theme.Efd" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <!-- 視窗、狀態列、導覽列與各頁相同的薄荷綠，切換頁面時不會閃出深色 -->
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <!-- 全域白色文字會讓白底對話框的按鈕與內文「白底白字」隱形，對話框改用專屬主題 -->
        <item name="alertDialogTheme">@style/EfdAlertDialog</item>
        <item name="android:alertDialogTheme">@style/EfdAlertDialog</item>
    </style>

    <style name="EfdAlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/text_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="buttonBarPositiveButtonStyle">@style/EfdDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/EfdDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/EfdDialogButton</item>
    </style>

    <style name="EfdDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
